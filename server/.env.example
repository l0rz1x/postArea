PORT=5000
NODE_ENV=development
JWT_SECRET=supersecretjwtkey_postarea_2026_modern

# Database Settings
# Use 'sqlite' for zero-config local development without installing MySQL.
# Change to 'mysql' if you have MySQL or XAMPP running.
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# MySQL settings (used when DB_DIALECT=mysql)
DB_NAME=tutorialDB
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

CLIENT_URL=http://localhost:3000
